{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "packing-list-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "packing-list-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview"
      ],
      "port": 4173
    },
    {
      "name": "packing-list-hosting",
      "runtimeExecutable": "firebase",
      "runtimeArgs": [
        "emulators:start",
        "--only",
        "hosting"
      ],
      "port": 5000
    }
  ]
}
