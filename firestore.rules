rules_version = '2';

// This is a two-person app. Access is limited to the accounts listed below —
// anyone can *sign in* with Google (that's Firebase Auth, and it creates a UID
// for them), but only these addresses can read or write any data. An account
// that signs in but isn't listed sees the "no access" screen.
//
// Deploy with:  npm run deploy        (hosting + rules)
//               npm run deploy:rules  (rules only)

service cloud.firestore {
  match /databases/{database}/documents {

    // ┌──────────────────────────────────────────────────────────────┐
    // │ WHO CAN USE THE APP — add an address here, then redeploy.    │
    // └──────────────────────────────────────────────────────────────┘
    function allowed() {
      return request.auth != null &&
             request.auth.token.email_verified == true &&
             request.auth.token.email in [
               'mike.v.rojas@gmail.com'
               , 'mije122012@gmail.com'
             ];
    }

    // ── Validation ────────────────────────────────────────────────
    //
    // The allowlist decides *who* writes; these decide *what* they can write.
    // Without them a bug in the import planner — or a compromised session —
    // could put anything of any size into any document.
    //
    // Deliberately shaped as "absent, or null, or the right type" rather than
    // "required". Documents written before a field existed must stay editable,
    // so a missing `notes` or `waitPrice` can never make an item unwritable.
    // Only `name` is genuinely required, because every view renders it.

    // Each check is "absent, or null, or the right type". The `in` test comes
    // first and short-circuits, so a field the document doesn't have is never
    // read — reading an absent property is an error in rules, not a false.
    //
    // Written out longhand with plain dot access rather than a d[key] helper:
    // it is more lines, but every line is verifiable by reading it, which
    // matters for the one thing standing between a bug and the whole dataset.

    function optStr(v, max)  { return v == null || (v is string && v.size() <= max); }
    function optNum(v)       { return v == null || v is number; }
    function optBool(v)      { return v == null || v is bool; }
    function optList(v, max) { return v == null || (v is list && v.size() <= max); }

    function validItem(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 200
          && d.keys().size() <= 50
          && (!('category'      in d) || optStr(d.category, 120))
          && (!('person'        in d) || optStr(d.person, 20))
          && (!('status'        in d) || optStr(d.status, 20))
          && (!('inBag'         in d) || optStr(d.inBag, 120))
          && (!('condition'     in d) || optStr(d.condition, 20))
          && (!('packStatus'    in d) || optStr(d.packStatus, 20))
          && (!('purchaseDate'  in d) || optStr(d.purchaseDate, 40))
          && (!('notes'         in d) || optStr(d.notes, 4000))
          && (!('qty'           in d) || optNum(d.qty))
          && (!('packedQty'     in d) || optNum(d.packedQty))
          && (!('estLifeMonths' in d) || optNum(d.estLifeMonths))
          && (!('targetPrice'   in d) || optNum(d.targetPrice))
          && (!('waitPrice'     in d) || optNum(d.waitPrice))
          && (!('sortOrder'     in d) || optNum(d.sortOrder))
          && (!('cost'          in d) || optNum(d.cost))
          && (!('worn'          in d) || optBool(d.worn))
          && (!('packed'        in d) || optBool(d.packed))
          && (!('purchases'     in d) || optList(d.purchases, 500));
    }

    function validBag(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 120
          && d.keys().size() <= 20
          && (!('owner' in d) || optStr(d.owner, 20))
          && (!('emoji' in d) || optStr(d.emoji, 16))
          && (!('order' in d) || optNum(d.order));
    }

    // settings/app holds shared exchange rates and a currency preference, and
    // both phones write to it. Bound it so a bad rates response can't balloon
    // the document.
    function validSettings(d) {
      return d.keys().size() <= 20
          && (!('activeCurrency' in d) || optStr(d.activeCurrency, 10))
          && (!('ratesSource'    in d) || optStr(d.ratesSource, 20))
          && (!('ratesUpdatedAt' in d) || optNum(d.ratesUpdatedAt))
          && (!('rates' in d) || d.rates == null ||
              (d.rates is map && d.rates.keys().size() <= 200));
    }

    // ── Collections ───────────────────────────────────────────────
    // Delete is split out on purpose: `request.resource` is null on a delete,
    // so validating it there would reject every deletion.

    match /items/{itemId} {
      allow read:          if allowed();
      allow create, update: if allowed() && validItem(request.resource.data);
      allow delete:        if allowed();
    }

    match /bags/{bagId} {
      allow read:          if allowed();
      allow create, update: if allowed() && validBag(request.resource.data);
      allow delete:        if allowed();
    }

    match /settings/{docId} {
      allow read:          if allowed();
      allow create, update: if allowed() && validSettings(request.resource.data);
      allow delete:        if allowed();
    }

    // Anything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
